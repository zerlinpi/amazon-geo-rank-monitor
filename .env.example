# Copy to .env. Empty secrets intentionally require operator configuration.
# Defaults below are for local development; see docs/DEPLOYMENT.md for HTTPS production.
# Compose overrides DATABASE_URL, AUTO_CREATE_SCHEMA, API_HOST, API_PORT and FORWARDED_ALLOW_IPS.

# Application and database
DATABASE_URL=sqlite+pysqlite:///./amazon_geo_rank_monitor.db
AUTO_CREATE_SCHEMA=true
API_HOST=127.0.0.1
API_PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
API_KEY_PEPPER=
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
REDIS_URL=
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Accounts, sessions and recovery
ALLOW_PUBLIC_SIGNUP=true
SESSION_TTL_HOURS=720
INVITATION_TTL_HOURS=168
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SESSION_COOKIE_NAME=agrm_session
CSRF_COOKIE_NAME=agrm_csrf
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# SMTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Encryption, MFA, SSO and SCIM
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Amazon Geo Rank Monitor
MFA_CHALLENGE_MINUTES=5
TRUSTED_DEVICE_DAYS=30
TRUSTED_DEVICE_COOKIE_NAME=agrm_trusted_device
SSO_ENCRYPTION_KEY=
SSO_CALLBACK_URL=http://localhost:8000/api/v1/auth/sso/callback
SSO_TRANSACTION_MINUTES=5
SCIM_TOKEN_PEPPER=
ALERT_ENCRYPTION_KEY=
ALERT_WEBHOOK_ALLOWED_HOSTS=
REPORT_ENCRYPTION_KEY=

# Workers, queue and scheduler
WORKER_POLL_SECONDS=2
WORKER_ID=
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=900
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=900
SCHEDULER_POLL_SECONDS=30
SCHEDULER_ID=
MCP_TENANT_ID=

# SERP providers and strict verification
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
RESIDENTIAL_PROXY_USERNAME=
RESIDENTIAL_PROXY_PASSWORD=
RESIDENTIAL_PROXY_SERVER=http://pr.oxylabs.io:7777
AUTO_STRICT_VERIFICATION_ENABLED=false
AUTO_STRICT_RANK_DELTA_THRESHOLD=20
AUTO_STRICT_VERIFY_NOT_FOUND_AFTER_FOUND=true
AUTO_STRICT_VERIFY_GEO_MISMATCH=true
AUTO_STRICT_RECOVER_LOW_CONFIDENCE=true
AUTO_STRICT_MIN_CONFIDENCE=0.75
AUTO_STRICT_MAX_PROBES_PER_RUN=3

# Probe cache
PROBE_CACHE_MANAGED_TTL_SECONDS=300
PROBE_CACHE_STRICT_TTL_SECONDS=0
PROBE_CACHE_RETENTION_HOURS=24

# Credits and Stripe
MANAGED_SERP_CREDIT_COST=1
STRICT_SERP_CREDIT_COST=5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing
BILLING_CURRENCY=usd
CREDIT_PACK_STARTER_CREDITS=500
CREDIT_PACK_STARTER_AMOUNT_MINOR=0
CREDIT_PACK_GROWTH_CREDITS=2000
CREDIT_PACK_GROWTH_AMOUNT_MINOR=0
CREDIT_PACK_SCALE_CREDITS=10000
CREDIT_PACK_SCALE_AMOUNT_MINOR=0

# Compose only: generate a strong URL-safe (hex) database password.
POSTGRES_PASSWORD=
# Dedicated private network: change all three together if this subnet overlaps your host.
AGRM_NETWORK_SUBNET=172.30.91.0/24
AGRM_NETWORK_GATEWAY=172.30.91.1
AGRM_FRONTEND_IP=172.30.91.10
# Host TLS proxy appears as the bridge gateway. Set an exact trusted peer; never * or 0.0.0.0/0.
TRUSTED_EDGE_PROXY_CIDR=172.30.91.1

# Frontend build only; use / for the same-origin Compose deployment.
VITE_AGRM_API_BASEURL=/
VITE_AGRM_CSRF_COOKIE_NAME=agrm_csrf
